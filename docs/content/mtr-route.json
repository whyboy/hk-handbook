  "reviewDueOn": null,
  "sections": {
    "applicability": {
      "state": "known",
      "reason": null,
      "blocks": [
        {
          "kind": "editorial_advice",
          "text": "适用于计划乘港铁、能够确定出发站和目的站的读者。本文只介绍官方信息查询，不判断入境资格、跨境通关时间、优惠资格或特殊票种是否适合你；轻铁及其他交通工具不在本次操作范围内。",
          "factIds": [],
          "experienceContext": null
        }
      ]
    },
    "materials": {
      "state": "known",
      "reason": null,
      "blocks": [
        {
          "kind": "editorial_advice",
          "text": "准备出发站、目的站、计划出行日期和大致时段，以及可联网的设备。申请材料不适用：这是一篇查询教程，不是购票、开户或身份办理指南；不应据此推断其他业务无需证件。",
          "factIds": [],
          "experienceContext": null
        }
      ]
    },
    "steps": {
      "state": "known",
      "reason": null,
      "blocks": [
        {
          "kind": "official_fact",
          "text": "选入口。已有 MTR Mobile 的读者，可按官方说明从首页的 Where to? 进入；也可使用港铁网页 Route Suggestion 的 From／To 和 Search 入口。",
          "factIds": [
            "f1",
            "f4"
          ],
          "experienceContext": null
        },
        {
          "kind": "official_fact",
          "text": "选起终点。按官方说明选择出发站和目的站，查看建议路线、行程时间、车费及首尾班信息。这里说明功能，不提供某一条具体路线的结果。",
          "factIds": [
            "f2"
          ],
          "experienceContext": null
        },
        {
          "kind": "official_fact",
          "text": "看换乘和尾班信息。港铁服务时间说明介绍换乘等查询信息，并提供独立的服务时间查询入口。",
          "factIds": [
            "f3",
            "f5"
          ],
          "experienceContext": null
        },
        {
          "kind": "editorial_advice",
          "text": "出发前再核实。按自己的方向和日期重新查看官方结果，不套用其他行程截图。页面打不开、信息不完整或看不懂换乘安排时，从来源入口重新核实，必要时向车站工作人员确认；不承诺一定赶上尾班车。",
          "factIds": [],
          "experienceContext": null
        }
      ]
    },
    "costsAndTime": {
      "state": "known",
      "reason": null,
      "blocks": [
        {
          "kind": "official_fact",
          "text": "车费和预计行程时间应按具体起终点在官方工具中核对，本稿不列固定票价和分钟数。",
          "factIds": [
            "f2",
            "f3"
          ],
          "experienceContext": null
        },
        {
          "kind": "editorial_advice",
          "text": "本文不评价优惠资格，也不把预计时间当作到达承诺。完成查询所需时间因设备、网络和熟悉程度而异，不虚填耗时。",
          "factIds": [],
          "experienceContext": null
        }
      ]
    },
    "warnings": {
      "state": "known",
      "reason": null,
      "blocks": [
        {
          "kind": "editorial_advice",
          "text": "本稿基于官方功能说明，不是乘车实测。AI 查阅和浏览器自动检查不等于人工事实核验；App 真机、实际当日运营、具体票价和首尾班安排仍需核实。",
          "factIds": [],
          "experienceContext": null
        },
        {
          "kind": "editorial_advice",
          "text": "个人经验：无，不编造亲历。出发前再查、核对方向及询问工作人员属于编辑建议，不是官方办理规定。",
          "factIds": [],
          "experienceContext": null
        },
        {
          "kind": "editorial_advice",
          "text": "这份内容仍是内部草稿，人工事实核验、真实查询及产品评审未完成，不能据此作为已审核攻略公开发布。",
          "factIds": [],
          "experienceContext": null
        }
      ]
    }
  },
